# Frontend environment (public) — variables prefixed with VITE_ are exposed to browser

# Base URL for backend API. Required: yes (for the frontend to call APIs).
# Example: VITE_API_URL=http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# Frontend public URL for links. Required: no
# Example: VITE_FRONTEND_URL=http://localhost:5173
VITE_FRONTEND_URL=http://localhost:5173

# DO NOT put any secrets here (database URIs, JWT_SECRET, API keys, private keys).