# Frontend environment (public) — variables prefixed with VITE_ are exposed to browser

# Base URL for backend API. Required: yes (for the frontend to call APIs).
VITE_API_URL=http://localhost:5000/api

# Frontend public URL for links.
VITE_FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Used by Google Identity Services SDK in the browser
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# DO NOT put any secrets here (database URIs, SESSION_SECRET, API keys, private keys).